{
  "name": "mahjong-server-manager",
  "version": "1.0.0",
  "description": "Server Manager for Mahjong Game",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "deploy": "node deploy.js",
    "clean": "node -e \"const fs=require('fs');const p=require('path');const r=p.resolve(__dirname,'..');['ServerManager.exe','dist-manager'].forEach(f=>{try{fs.rmSync(p.join(r,f),{recursive:true,force:true})}catch(_){}});console.log('Clean done')\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mahjong.server-manager",
    "productName": "ServerManager",
    "directories": {
      "output": "../dist-manager"
    },
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "index.html",
      "style.css",
      "app.js"
    ],
    "asar": true
  }
}

