{
  "name": "mahjong-server-manager",
  "version": "1.0.0",
  "description": "Server Manager for Mahjong Game",
  "main": "index.html",
  "window": {
    "title": "Server Manager - Mahjong Game",
    "width": 640,
    "height": 720,
    "min_width": 500,
    "min_height": 500,
    "icon": "icon.png",
    "position": "center",
    "resizable": true
  },
  "dependencies": {},
  "devDependencies": {
    "nw": "0.92.0",
    "@yao-pkg/pkg": "^6.0.0"
  },
  "scripts": {
    "start": "nw .",
    "start:standalone": "node standalone.js",
    "deploy": "node deploy.js",
    "clean": "node -e \"const fs=require('fs');const p=require('path');const r=p.resolve(__dirname,'..');try{fs.unlinkSync(p.join(r,'ServerManager.exe'))}catch(_){};console.log('Clean done')\""
  }
}
